# OpenVINO image: the ASR model runs on an Intel GPU via OpenVINO, the VAD on the CPU.
#
#   podman build -t asmr-asr-ov --format oci -f containerfile.openvino .
#   podman run --rm -v ./models:/srv/models:Z asmr-asr-ov python fetch_models.py --only vad
#   podman run --rm --device /dev/dri --group-add keep-groups \
#       -v ./models:/srv/models:ro,Z -p 127.0.0.1:8000:8000 asmr-asr-ov
#
# --device /dev/dri exposes the GPU; --group-add keep-groups carries the host's
# render group membership into a rootless container. Without both, OpenVINO reports
# no GPU device and runs on the CPU at a fraction of the speed.
#
# The models volume holds the VAD plus one IR directory per precision:
#
#   models/whisper_vad.onnx          fetch_models.py --only vad
#   models/whisper_vad_metadata.json
#   models/ov-int8/                  OpenVINO IR, int8 weights (1.6 GB)
#   models/ov-fp32/                  OpenVINO IR, fp32 weights (6.2 GB)
#
# Build the IR outside this image; export peaks around 8.5 GB RSS.

# Fedora, where the CPU image uses python:3.14-slim: Debian trixie carries no
# intel-opencl-icd (bookworm and forky do, trixie does not) and Debian stable has
# never packaged a Level Zero GPU driver, so the Intel compute stack is not
# installable there. Fedora 44 ships both, and its python3 is 3.14 — the floor
# pyproject.toml sets — so the image needs no second interpreter.
FROM registry.fedoraproject.org/fedora:44

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

# intel-compute-runtime is the NEO driver, providing both the OpenCL and Level Zero
# GPU backends OpenVINO dispatches through; oneapi-level-zero is the loader in front
# of it. libgomp is the OpenMP runtime ONNX Runtime links against. clinfo reports
# which devices the container can actually see.
RUN dnf install -y --setopt=install_weak_deps=False \
        python3 libgomp intel-compute-runtime oneapi-level-zero clinfo \
 && dnf clean all

WORKDIR /srv

ENV UV_PROJECT_ENVIRONMENT=/srv/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/srv/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Dependency layer first: rebuilt only when the lock changes, not on every edit.
# The openvino extra carries the OpenVINO stack, and pyproject.toml routes torch and
# torchvision to PyTorch's CPU index, so nothing here pulls a CUDA build.
# --python names the system interpreter, which uv would otherwise pass over in
# favour of downloading a managed build of the same version.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra openvino --python /usr/bin/python3

COPY asr/ asr/
COPY serve.py fetch_models.py generation_config.json5 ov_backend.py ./

# ov_backend.py sits outside the asr package because it imports transformers, which
# asr/ is kept free of; asr/server.py imports it lazily when --backend is openvino.
#
# ASR_BACKEND, OV_PRECISION and OV_DEVICE are the defaults for --backend,
# --ov_precision and --ov_device. Precision selects models/ov-int8 or models/ov-fp32.
ENV ASR_BACKEND=openvino \
    OV_PRECISION=int8 \
    OV_DEVICE=GPU

VOLUME /srv/models
EXPOSE 8000

# 0.0.0.0 because the container's loopback is unreachable from the host.
CMD ["python", "serve.py", "--host", "0.0.0.0", "--port", "8000"]
