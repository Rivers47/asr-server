# GPU image. The ASR model runs on CUDA via CTranslate2; the VAD stays on CPU
# unless you opt in below.
#
#   docker build -f Dockerfile.gpu -t asmr-asr:gpu .
#   docker run --rm --gpus all -v "$PWD/models:/srv/models" -p 8000:8000 asmr-asr:gpu
#
# CTranslate2 needs a GPU of compute capability 7.0 or newer for float16, and
# 8.0+ for bfloat16; older cards fall back to float32 or fail outright. Check
# yours before assuming this image works: `nvidia-smi --query-gpu=compute_cap --format=csv`.
#
# UNVERIFIED: this file has not been built or run. The CPU image is the tested path.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# Ubuntu 22.04 ships Python 3.10, which matches requires-python.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3.10 python3.10-venv libgomp1 ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /srv
ENV UV_PROJECT_ENVIRONMENT=/srv/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/srv/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python /usr/bin/python3.10

# The VAD is a 114 MB graph run once per 30 s chunk, so CPU is usually the right
# trade -- onnxruntime-gpu drags in roughly 2 GB of CUDA wheels. Build with
# --build-arg VAD_ON_GPU=1 to put it on the GPU instead.
ARG VAD_ON_GPU=0
RUN if [ "$VAD_ON_GPU" = "1" ]; then \
        uv pip uninstall onnxruntime && uv pip install "onnxruntime-gpu>=1.17,<1.24"; \
    fi

COPY asr/ asr/
COPY serve.py fetch_models.py generation_config.json5 ./

RUN useradd --create-home --uid 10001 asr && chown -R asr:asr /srv
USER asr

VOLUME /srv/models
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5)"

CMD ["python", "serve.py", "--host", "0.0.0.0", "--port", "8000", "--device", "cuda"]
